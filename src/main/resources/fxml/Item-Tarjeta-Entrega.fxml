<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="1.7976931348623157E308" prefWidth="270.0" spacing="8.0" style="-fx-background-color: #221417; -fx-background-radius: 12; -fx-border-color: #352024; -fx-border-radius: 12; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uam.ayd.proyecto.presentacion.misEntregas.ControlItemTarjetaEntrega">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <!-- Encabezado: #Orden y Hora -->
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <children>
                <Label fx:id="lblNumeroOrden" text="#845" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label text="•" textFill="#888888" />
                <Label fx:id="lblHora" text="🕒 20:15" textFill="#D0C0C2">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
            </children>
        </HBox>

        <!-- Datos de Entrega -->
        <VBox spacing="4.0" style="-fx-background-color: #160E10; -fx-background-radius: 8; -fx-padding: 8;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label text="👤" textFill="#E53935"><font><Font size="10.0" /></font></Label>
                        <Label fx:id="lblCliente" text="Hiroshi Tanaka" textFill="WHITE">
                            <font><Font name="System Bold" size="11.5" /></font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label text="📞" textFill="#E53935"><font><Font size="10.0" /></font></Label>
                        <Label fx:id="lblTelefono" text="55 1234 5678" textFill="#D0C0C2">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="TOP_LEFT" spacing="6.0">
                    <children>
                        <Label text="📍" textFill="#E53935"><font><Font size="10.0" /></font></Label>
                        <Label fx:id="lblDireccion" text="Calle Sakura #45, Depto 302" textFill="#D0C0C2" wrapText="true">
                            <font><Font size="10.5" /></font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Indicador de Cobro (HU-13) -->
        <HBox alignment="CENTER_LEFT" spacing="4.0">
            <children>
                <Label text="TOTAL A COBRAR: " textFill="WHITE">
                    <font><Font name="System Bold" size="11.0" /></font>
                </Label>
                <Label fx:id="lblTotalCobrar" text="$450.00" textFill="#E53935">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
            </children>
        </HBox>

        <!-- Botón Táctil de Cierre Operativo -->
        <Button fx:id="btnMarcarEntregado" maxWidth="1.7976931348623157E308" prefHeight="36.0" style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 6; -fx-cursor: hand;" text="✓  MARCAR COMO ENTREGADO" />
    </children>
</VBox>