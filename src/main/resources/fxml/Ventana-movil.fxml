<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" style="-fx-background-color: #0D0809; -fx-padding: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ControlMisEntregas">
   <children>
      <!-- Carcasa del Celular Compacta (300px x 600px) -->
      <VBox maxHeight="600.0" maxWidth="300.0" minHeight="600.0" minWidth="300.0" prefHeight="600.0" prefWidth="300.0" style="-fx-background-color: #160E10; -fx-background-radius: 32; -fx-border-color: #4A4D57; -fx-border-radius: 32; -fx-border-width: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 18, 0, 0, 6);">
         <children>
            
            <!-- 1. Muesca / Notch Superior -->
            <HBox alignment="CENTER" prefHeight="10.0">
               <children>
                  <Region prefHeight="10.0" prefWidth="85.0" style="-fx-background-color: #000000; -fx-background-radius: 0 0 8 8;" />
               </children>
            </HBox>

            <!-- 2. Barra de Estado Móvil -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 2 12 3 12;">
               <children>
                  <Label text="9:41" textFill="#D0C0C2">
                     <font><Font name="System Bold" size="10.5" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="📶  📡  🔋" textFill="#A0888B">
                     <font><Font size="9.0" /></font>
                  </Label>
               </children>
            </HBox>

            <!-- 3. Encabezado Ryuho Sushi -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 4 12 6 12; -fx-border-color: #352024; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label text="Ryuho Sushi" textFill="#E53935">
                     <font><Font name="System Bold" size="16.0" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" style="-fx-background-color: #221417; -fx-text-fill: #FFFFFF; -fx-font-size: 11px; -fx-background-radius: 5; -fx-cursor: hand; -fx-border-color: #352024; -fx-border-radius: 5;" text="🚪" />
               </children>
            </HBox>

            <!-- 4. Título "MIS ENTREGAS" -->
            <VBox alignment="CENTER" spacing="1.0" style="-fx-padding: 5 0 5 0;">
               <children>
                  <Label text="MIS ENTREGAS" textFill="WHITE">
                     <font><Font name="System Bold" size="16.0" /></font>
                  </Label>
                  <Label fx:id="lblPendientes" text="(0 Pendientes)" textFill="#B0999C">
                     <font><Font size="10.5" /></font>
                  </Label>
               </children>
            </VBox>

            <!-- 5. Área del Contenedor (Scrollable) -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #160E10;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vboxContenedorEntregas" spacing="8.0" style="-fx-background-color: #160E10;">
                     <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="4.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>

            <!-- 6. Bloque Inferior Redondeado (Curvatura Interna Ajustada a 27px) -->
            <VBox style="-fx-background-color: #1F1315; -fx-background-radius: 0 0 27 27; -fx-border-color: #352024; -fx-border-width: 1 0 0 0; -fx-border-radius: 0 0 27 27;">
               <children>
                  <!-- Menú de Navegación -->
                  <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 5 0 3 0;">
                     <children>
                        <VBox alignment="CENTER" spacing="1.0">
                           <children>
                              <Label text="📋" textFill="#E53935"><font><Font size="12.0" /></font></Label>
                              <Label text="Entregas" textFill="#E53935"><font><Font name="System Bold" size="8.5" /></font></Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="1.0" />
                        <VBox alignment="CENTER" spacing="1.0">
                           <children>
                              <Label text="👤" textFill="#A0888B"><font><Font size="12.0" /></font></Label>
                              <Label text="Perfil" textFill="#A0888B"><font><Font size="8.5" /></font></Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Barra 'Home' Inferior -->
                  <HBox alignment="CENTER" style="-fx-padding: 2 0 5 0;">
                     <children>
                        <Region prefHeight="3.0" prefWidth="80.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-opacity: 0.35;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>
